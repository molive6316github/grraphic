# MXT DB (Required) — the app's database/REST backend (PostgREST-compatible).
# URL is the project base; anon key is the public key sent as the apikey header.
VITE_MXTDB_URL=https://db.mxt.productions/api/v1/projects/your-project-ref
VITE_MXTDB_ANON_KEY=your-mxtdb-anon-key-here

# Hack Club AI (Required for design analysis)
# Used SERVER-SIDE only by the /api/analyze edge function (Hack Club's proxy
# sends no CORS headers, so the browser can't call it directly). No VITE_
# prefix means the key is never shipped to the browser.
# Get a key from: https://ai.hackclub.com
HACKCLUB_API_KEY=your-hackclub-api-key-here
# Optional: override the primary vision model (must accept image input).
# Falls back through a second free vision model, then openrouter/free.
# Default: inclusionai/ling-3.0-flash-vl:free
# HACKCLUB_MODEL=inclusionai/ling-3.0-flash-vl:free

# Stripe Configuration (Optional - only needed for payments)
# Get from: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-key-here

# GateKey Auth (Required for sign-in) — SERVER-SIDE only, used by /api/auth/*
# client_id is your GateKey app id; client_secret is the gks_... value.
GATEKEY_CLIENT_ID=grraphic
GATEKEY_CLIENT_SECRET=your-gatekey-client-secret-here
# Must exactly match the redirect_uri registered in GateKey (HTTPS, MXT domain).
GATEKEY_REDIRECT_URI=https://www.grraphic.xyz/auth/callback

# Supabase service-role key — SERVER-SIDE only. Used by /api/auth/callback to
# map GateKey users onto Supabase users so existing RLS/data keeps working.
# Get from: Supabase Dashboard > Settings > API > service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Encryption Secret (Optional - used to encrypt stored analysis data)
VITE_ENCRYPTION_SECRET=your-random-secret-here
